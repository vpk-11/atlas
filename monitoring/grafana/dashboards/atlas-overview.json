{
  "title": "Atlas Overview",
  "uid": "atlas-overview",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Request Throughput (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{app=\"dispatch-service\", uri=\"/rides\"}[1m]))",
          "legendFormat": "req/sec"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency p50 / p99 (POST /rides)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{app=\"dispatch-service\", uri=\"/rides\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{app=\"dispatch-service\", uri=\"/rides\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate (5xx / total)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{app=\"dispatch-service\", uri=\"/rides\", status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{app=\"dispatch-service\", uri=\"/rides\"}[1m]))",
          "legendFormat": "error rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Dispatch Pod Count Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "count(up{app=\"dispatch-service\"} == 1)",
          "legendFormat": "live pods"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0 },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Match Rate (MATCHED / MATCHED+FAILED_NO_MATCH)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(ride_match_outcomes_total{outcome=\"matched\"}[5m])) / sum(rate(ride_match_outcomes_total{outcome=~\"matched|failed_no_match\"}[5m]))",
          "legendFormat": "match rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      }
    }
  ]
}
